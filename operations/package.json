{
  "name": "airbnb-hoa-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "open:mac": "tools/open_airbnb_hoa.sh",
    "open:display": "tools/open_airbnb_hoa.sh --display",
    "open:display:lan": "tools/open_airbnb_hoa.sh --display --lan",
    "install:mac-app": "tools/install_macos_launcher.sh",
    "refresh:calendar": "python3 tools/import_airbnb_ical.py --output data/airbnb-florida-calendar-snapshot.json",
    "daily:check": "python3 tools/daily_watch.py",
    "daily:reminder": "python3 tools/daily_reminder.py --notify",
    "install:daily-reminder": "tools/install_daily_reminder_agent.sh",
    "integration:status": "python3 tools/integration_status.py",
    "health:check": "python3 tools/health_check.py",
    "operations:check": "python3 tools/operations_tree_check.py && python3 tools/ui_contract_check.py",
    "test:smoke": "python3 tools/smoke_check.py",
    "test:server": "python3 tools/server_contract_test.py",
    "proxmox:readiness": "python3 tools/proxmox_vm_readiness.py",
    "proxmox:preflight": "bash deploy/proxmox/preflight-airbnb-hoa.sh",
    "proxmox:install:dry-run": "bash deploy/proxmox/install-airbnb-hoa.sh --dry-run",
    "proxmox:backup:dry-run": "bash deploy/proxmox/backup-airbnb-hoa.sh --dry-run",
    "proxmox:restore:dry-run": "bash deploy/proxmox/restore-drill-airbnb-hoa.sh --dry-run",
    "gbrain:export": "python3 tools/gbrain_export.py",
    "gbrain:sync": "python3 tools/gbrain_sync.py",
    "hermes:context": "python3 tools/hermes_context.py --default-output",
    "hermes:context:refresh": "python3 tools/hermes_context.py --refresh-calendar --default-output",
    "imessage:macmini:health": "python3 tools/imessage_readonly.py health",
    "imessage:macmini:airbnb": "python3 tools/imessage_readonly.py search Airbnb --limit 20 --since-days 365",
    "calendar:export": "python3 tools/sync_apple_calendar.py",
    "calendar:sync": "python3 tools/sync_apple_calendar.py --calendar-name Florida --sync-apple-calendar",
    "panama:phone:status": "python3 tools/check_panama_ip_phone.py"
  }
}
